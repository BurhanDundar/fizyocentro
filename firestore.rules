rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Helper function to check if user is the owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection rules
    match /users/{userId} {
      // Users can only read their own document
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());

      // Only admins can create/update user documents
      // In production, you might want to use Cloud Functions for user creation
      allow create, update: if isAdmin();

      // No one can delete users through client
      allow delete: if false;
    }

    // Appointments collection rules
    match /appointments/{appointmentId} {
      // Allow read if:
      // - User is admin (can see all appointments)
      // - User is the owner of the appointment (employee can see their own)
      allow read: if isAuthenticated() && (
        isAdmin() ||
        isOwner(resource.data.userId)
      );

      // Allow create if:
      // - User is admin (can create for anyone)
      // - User is creating for themselves
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isOwner(request.resource.data.userId)
      ) && request.resource.data.keys().hasAll([
        'userId',
        'patientName',
        'description',
        'startTime',
        'endTime',
        'createdAt'
      ]) && request.resource.data.patientName is string
        && request.resource.data.description is string
        && request.resource.data.startTime is timestamp
        && request.resource.data.endTime is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.endTime > request.resource.data.startTime;

      // Allow update if:
      // - User is admin (can update any appointment)
      // - User owns the appointment
      allow update: if isAuthenticated() && (
        isAdmin() ||
        isOwner(resource.data.userId)
      ) && request.resource.data.userId == resource.data.userId; // Cannot change userId

      // Allow delete if:
      // - User is admin (can delete any appointment)
      // - User owns the appointment
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        isOwner(resource.data.userId)
      );
    }
  }
}
